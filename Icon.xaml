<Page
    x:Class="TrayTools.Icon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayTools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Auto"
                  HorizontalScrollMode="Auto">
        <StackPanel Padding="32" Spacing="20">
            <TextBlock x:Name="PageTitle" Text="Icon 1" FontSize="24" FontWeight="Bold" Grid.Row="2" Grid.Column="2" />
            <!-- Top Icon + Input Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Height="120" Width="120" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="10">
                    <Grid>
                        <Image x:Name="ImageIconPreview" ImageOpened="Image_ImageOpened" ImageFailed="Image_ImageFailed" Source="/Assets/logo.png" Width="100" Height="100" Margin="5"/>
                        <TextBlock x:Name="TextIconPreview" Text="" FontSize="87" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox SelectionChanged="IconTypeCombo_SelectionChanged" x:Name="IconTypeCombo" Width="150" PlaceholderText="Set Icon Type" Tag="iconTypeInput">
                            <x:String>Image</x:String>
                            <x:String>Text + Emoji</x:String>
                            <x:String>Invisible</x:String>
                        </ComboBox>
                        <TextBox TextChanged="IconImagePath_TextChanged" Width="200" PlaceholderText="Image Path" x:Name="IconImagePath" Tag="iconTitleInput"/>
                        <Button Click="BrowseImageButton_Click" x:Name="BrowseImageButton" Width="150" Tag="iconTitleInput">Browse for Image</Button>
                    </StackPanel>
                    <TextBlock x:Name="ImageRecommendationText" Text="Recommended Dimensions: 120x120 (Or any 1:1 image). Must be in .ICO format" FontSize="14" Foreground="LightGray"/>
                    <InfoBar x:Name="ImageFailedInfoBar" IsOpen="True" Severity="Warning" Title="" Message="The image could not be loaded." IsClosable="False"/>
                    <InfoBar x:Name="ImageRequiresConvertingInfoBar" Visibility="Collapsed" IsOpen="True" Severity="Informational" Title="" Message="This image needs to be converted to an Icon before it can be used." IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button x:Name="ConvertIcon" Click="ConvertIcon_Click">Convert to Icon</Button>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar x:Name="ImageConvertionStatusInfoBar" Visibility="Collapsed" IsOpen="True" Severity="Informational" Title="" Message="" IsClosable="False" />
                </StackPanel>
            </Grid>

            <!-- Section Header -->
            <TextBlock Text="Icon Settings" FontSize="20" FontWeight="SemiBold"/>

            <!-- Icon Name Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Icon Name" FontSize="14"/>
                        <TextBlock Text="The name displayed on hover, and in this menu" FontSize="12" Foreground="LightGray"/>
                    </StackPanel>
                    <TextBox x:Name="IconName" Width="200" Height="1" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="iconTitleInput"/>
                </Grid>
            </Border>

            <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold"/>

            <!-- Left Click Action -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Left-Click Action" FontSize="14"/>
                        <TextBlock Text="What should happen when you click your icon?" FontSize="12" Foreground="LightGray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <ComboBox x:Name="LeftClickCombo" Width="150" SelectedValue="Do Nothing" Tag="stringInpTwo">
                            <x:String>Do Nothing</x:String>
                            <x:String>Open File/App</x:String>
                            <x:String>Open URL</x:String>
                        </ComboBox>
                        <TextBox x:Name="LeftClickActionDetails" Width="200" PlaceholderText="Action Details" Tag="iconTitleInput"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Click Menu Items -->
            <Expander Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="16"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Padding="0,16">
                        <TextBlock Text="Context-Menu Actions" FontSize="14"/>
                        <TextBlock Text="Add actions to the popup menu when right-clicking" FontSize="12" Foreground="LightGray"/>
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="10">
                    <ListView CanReorderItems="True"
                              AllowDrop="True"
                              ReorderMode="Enabled"
                              HorizontalAlignment="Stretch"
                              SelectionMode="None"
                              x:Name="ActionsList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ActionItem">
                                <Grid>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE784;" FontSize="16" VerticalAlignment="Center" Margin="-15,0,8,0"/>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="8" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                                <TextBox Text="{x:Bind Name, Mode=TwoWay}" Width="200" Height="1" PlaceholderText="Action Name"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                <TextBlock Text="Action:" FontSize="14" VerticalAlignment="Center"/>
                                                <ComboBox Width="150" SelectedIndex="{x:Bind Type, Mode=TwoWay}">
                                                    <x:String>Separator</x:String>
                                                    <x:String>Open File/App</x:String>
                                                    <x:String>Open URL</x:String>
                                                </ComboBox>
                                                <TextBox Text="{x:Bind Details, Mode=TwoWay}" Width="200" Height="1" PlaceholderText="Action Details"/>
                                                <Button Click="ContextMenuRemoveActionClickHandler" Tag="{x:Bind}">
                                                    <SymbolIcon Symbol="Delete"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="ContextMenuAddActionClickHandler">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Add Action"/>
                                <SymbolIcon>Add</SymbolIcon>
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Foreground="LightGray" Text="To change the order of these items, click and drag them up/down in the list."/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="DeleteIcon" Click="DeleteIcon_Click" Style="{StaticResource DangerButtonStyle}" Content="Delete Icon"/>
                <Button x:Name="SaveRefresh" Click="SaveRefresh_Click" Style="{StaticResource AccentButtonStyle}" Content="Save and Refresh"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
